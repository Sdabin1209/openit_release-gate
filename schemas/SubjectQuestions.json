{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubjectQuestions",
  "description": "I1에서 읽은 판정 대상의 문항 쪽 내용",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bank": {
      "type": [
        "object",
        "null"
      ],
      "description": "문항 세트(계약 QuestionBank). 읽지 못했으면 null"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviews_ok": {
      "type": "boolean"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "bank",
    "reviews",
    "reviews_ok",
    "problems"
  ]
}
