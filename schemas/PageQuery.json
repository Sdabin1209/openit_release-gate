{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageQuery",
  "description": "목록 쿼리의 쪽 크기(1~500). HTTP 면이 정수로 바꾼 값을 검사한다",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": [
    "limit"
  ]
}
