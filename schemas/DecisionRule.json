{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionRule",
  "description": "GateDecision의 PASS/REJECT 규칙(D53). 모양은 계약 GateDecision이 정본이고 여기는 판정 규칙만 적는다: PASS는 모든 검사가 PASS이고 HUMAN_APPROVAL 검사와 release_id·approval_id가 있으며 사유가 없다. REJECT는 사유와 코드가 있고 release_id가 없다",
  "type": "object",
  "required": [
    "result",
    "checks"
  ],
  "properties": {
    "result": {
      "enum": [
        "PASS",
        "REJECT"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "result"
        ]
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "result": {
          "const": "PASS"
        },
        "checks": {
          "items": {
            "properties": {
              "result": {
                "const": "PASS"
              }
            }
          },
          "contains": {
            "properties": {
              "kind": {
                "const": "HUMAN_APPROVAL"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "required": [
        "release_id",
        "approval_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "reject_reasons"
            ]
          },
          {
            "required": [
              "reject_codes"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "result": {
          "const": "REJECT"
        },
        "reject_reasons": {
          "type": "array",
          "minItems": 1
        },
        "reject_codes": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "reject_reasons",
        "reject_codes"
      ],
      "not": {
        "required": [
          "release_id"
        ]
      }
    }
  ]
}
