{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelInventory",
  "description": "I3에서 읽은 감시 대상: 패키지 버전 요약들과 건너뛴 항목",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "versions": {
      "type": "array",
      "items": {
        "$ref": "ModelVersionSummary.json"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "versions",
    "skipped"
  ]
}
