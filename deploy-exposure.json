{
  "service": "release-gate",
  "routes": [
    {
      "paths": [
        "/v1/submissions",
        "/v1/submissions/*"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "release-approver"
        ]
      },
      "upstream_token": "gate-read-release-approver",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 180000
      }
    },
    {
      "paths": [
        "/v1/approvals"
      ],
      "methods": [
        "POST"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "release-approver"
        ]
      },
      "upstream_token": "gate-write-release-approver",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 180000
      },
      "max_body_bytes": 1048576
    },
    {
      "paths": [
        "/v1/active-pointer",
        "/v1/releases"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "operator"
        ]
      },
      "upstream_token": "gate-read-operator",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 180000
      }
    },
    {
      "paths": [
        "/v1/activate",
        "/v1/rollback"
      ],
      "methods": [
        "POST"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "operator"
        ]
      },
      "upstream_token": "gate-write-operator",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 180000
      },
      "max_body_bytes": 1048576
    },
    {
      "paths": [
        "/v1/submissions"
      ],
      "methods": [
        "POST"
      ],
      "auth": {
        "kind": "denied"
      },
      "max_body_bytes": 1048576
    },
    {
      "paths": [
        "/v1/active-pointer",
        "/v1/releases/*"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "machine-token"
      },
      "upstream_token": "gate-read-model-serving",
      "user_header": "strip",
      "streaming": true
    },
    {
      "paths": [
        "/v1/decisions",
        "/v1/decisions/*"
      ],
      "auth": {
        "kind": "denied"
      }
    }
  ],
  "egress": [
    "question-authoring",
    "model-registry",
    "external:backup"
  ]
}
