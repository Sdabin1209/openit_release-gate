{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-build-context.schema.json",
  "title": "GateBuildInterface",
  "description": "release-gate 이미지 빌드의 입력 약속(deploy가 주고 release-gate가 받는다). 지금은 파일이 아니라 환경 변수 + 디렉터리 배치이며, 이 스키마는 그것을 데이터로 적은 초안이다(실제 이 JSON 파일을 읽는 코드는 없다). 빌드 컨텍스트 레이아웃은 scripts/stage_context.sh의 결과, 라벨은 Dockerfile의 LABEL.",
  "type": "object",
  "additionalProperties": false,
  "required": ["inputs", "context_layout", "labels"],
  "properties": {
    "inputs": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "BOUNDARY_CONTRACTS_TAG": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "없으면 requirements.txt의 pin."},
        "GATE_LIB_WHEELS_DIR": {"type": "string", "description": "turn_engine·model_runtime wheel이 든 디렉터리(deploy가 준비)."},
        "TURN_ENGINE_TAG": {"type": "string"}, "MODEL_RUNTIME_TAG": {"type": "string"}
      },
      "description": "GATE_LIB_WHEELS_DIR가 없으면 TURN_ENGINE_TAG와 MODEL_RUNTIME_TAG가 둘 다 필요하다."
    },
    "context_layout": {
      "type": "object", "additionalProperties": false, "required": ["wheels", "survey-schema", "release-gate"],
      "properties": {
        "wheels": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+-[0-9][^-]*-.+\\.whl$"}, "contains": {"type": "string", "pattern": "^boundary_contracts-"}, "description": "boundary_contracts wheel 필수, turn_engine·model_runtime wheel은 있을 때만"},
        "survey-schema": {"type": "array", "items": {"enum": ["CONTRACT_VERSION", "schemas"]}, "uniqueItems": true, "minItems": 2},
        "release-gate": {"type": "array", "items": {"enum": ["pyproject.toml", "requirements.lock", "release_gate"]}, "uniqueItems": true, "minItems": 3}
      }
    },
    "labels": {
      "type": "object", "additionalProperties": false,
      "required": ["io.openit.service", "io.openit.revision", "io.openit.contracts.boundary", "io.openit.contracts.survey-schema", "io.openit.turn-engine", "io.openit.model-runtime"],
      "properties": {
        "io.openit.service": {"const": "release-gate"}, "io.openit.revision": {"type": "string", "minLength": 1},
        "io.openit.contracts.boundary": {"type": "string", "minLength": 1}, "io.openit.contracts.survey-schema": {"type": "string", "minLength": 1},
        "io.openit.turn-engine": {"type": "string", "minLength": 1}, "io.openit.model-runtime": {"type": "string", "minLength": 1}
      }
    }
  }
}
