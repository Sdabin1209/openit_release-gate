{
  "data_dir": "/data",
  "i1_factory": "release_gate.factories:http_question_reader",
  "i1_options": {
    "base_url": "http://question-authoring:8080",
    "token": {
      "secret": "GATE_I1_TOKEN"
    }
  },
  "i3_factory": "release_gate.factories:http_model_registry",
  "i3_options": {
    "base_url": "http://model-registry:8080"
  },
  "watch": {
    "question_sets": [
      "qs-main"
    ],
    "lora_a": [
      "lora-a"
    ],
    "lora_b": [
      "lora-b"
    ]
  },
  "policy_file": "/etc/gate/policy.json"
}
