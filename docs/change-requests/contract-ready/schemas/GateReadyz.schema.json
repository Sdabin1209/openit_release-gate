{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GateReadyz.schema.json",
  "title": "GateReadyz",
  "description": "release-gate의 GET /readyz 본문. 200이면 ready, 503이면 not ready 또는 shutting_down. 인증 없음. 비밀과 접속 정보는 넣지 않는다. 알 수 없는 키는 소비자가 무시해야 한다(영역이 진단 수치를 덧붙일 수 있다).",
  "oneOf": [
    {
      "title": "ready (200)",
      "type": "object",
      "required": [
        "status",
        "database",
        "gate_policy_version",
        "judging",
        "awaiting_approval",
        "turn_engine_version",
        "model_runtime_version"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "database": {
          "enum": [
            "memory",
            "sqlite",
            "postgresql",
            "unknown"
          ],
          "description": "저장소 종류(store.kind). 접속 정보는 싣지 않는다."
        },
        "gate_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "judging": {
          "type": "string",
          "pattern": "^(enabled|disabled.*)$",
          "description": "판정 Loop 상태 문자열. 'enabled' 또는 'disabled (사유)'(I1·I3 미연결). 초안은 boolean이었으나 실제 서버 출력이 문자열이라 고쳤다."
        },
        "awaiting_approval": {
          "type": "integer",
          "minimum": 0
        },
        "turn_engine_version": {
          "type": "string",
          "minLength": 1
        },
        "model_runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "judging_loop": {
          "type": "object",
          "required": [
            "last_run_at",
            "consecutive_failures",
            "last_error",
            "neighbor_error",
            "upstream_auth_failed"
          ],
          "properties": {
            "last_run_at": {
              "type": [
                "number",
                "null"
              ],
              "description": "epoch 초"
            },
            "consecutive_failures": {
              "type": "integer",
              "minimum": 0
            },
            "last_error": {
              "$ref": "#/$defs/LoopError"
            },
            "neighbor_error": {
              "$ref": "#/$defs/LoopError"
            },
            "upstream_auth_failed": {
              "type": "boolean"
            }
          }
        },
        "retention": {
          "type": "object",
          "required": [
            "releases",
            "pruned_releases",
            "submissions",
            "policy"
          ],
          "properties": {
            "releases": {
              "type": "integer",
              "minimum": 0
            },
            "pruned_releases": {
              "type": "integer",
              "minimum": 0
            },
            "submissions": {
              "type": "integer",
              "minimum": 0
            },
            "policy": {
              "type": "object",
              "required": [
                "keep_releases",
                "rejected_days",
                "attempts_days"
              ],
              "properties": {
                "keep_releases": {
                  "type": "integer",
                  "minimum": 0
                },
                "rejected_days": {
                  "type": "integer",
                  "minimum": 1
                },
                "attempts_days": {
                  "type": "integer",
                  "minimum": 1
                },
                "runs": {
                  "type": "string"
                }
              }
            }
          }
        },
        "db_stats_stale": {
          "type": "boolean",
          "description": "주 연결이 막혀 마지막 값을 낼 때만 true"
        }
      }
    },
    {
      "title": "not ready (503)",
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "not ready"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    {
      "title": "shutting down (503)",
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "shutting_down"
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "LoopError": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
