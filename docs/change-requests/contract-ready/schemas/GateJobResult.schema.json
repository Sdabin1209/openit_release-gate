{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GateJobResult.schema.json",
  "title": "GateJobResult",
  "description": "run-once 잡이 표준 출력에 내는 JSON 한 줄과 종료 코드의 약속. release-gate가 내고 deploy 스케줄러가 읽는다. 종료 코드: 0 = status ok, 75 = 재시도 가능(UNAVAILABLE, status deferred 또는 failed+retryable), 1 = 그 밖의 실패(partial 포함, 인증 실패 등 재시도로 풀리지 않는 것). 설정 오류(SystemExit)와 예기치 못한 예외도 stdout에 JSON 한 줄(status \"failed\" + 오류 코드)로 낸다(헤드 결정 2026-10-29), 종료 코드는 위 표 그대로 1이다. 그 두 경우의 구체적 code 대응은 구현 단계에서 정한다(이 스키마는 BoundaryError 코드 전체를 허용한다). 쓰는 쪽은 닫힌 형식으로 내고 읽는 쪽(스케줄러)은 모르는 키를 무시한다.",
  "type": "object",
  "required": [
    "job",
    "status"
  ],
  "properties": {
    "job": {
      "enum": [
        "collect",
        "judge",
        "prune"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "deferred",
        "failed"
      ]
    }
  },
  "oneOf": [
    {
      "title": "collect ok/partial",
      "properties": {
        "job": {
          "const": "collect"
        },
        "status": {
          "enum": [
            "ok",
            "partial"
          ]
        },
        "submitted": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(question_set|package):.+:[A-Z_]+$"
          },
          "description": "읽지 못해 건너뛴 항목 '종류:ID:오류코드'. status가 partial일 때만 있고, 종료 코드 1."
        }
      },
      "required": [
        "submitted",
        "new"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "required": [
          "skipped"
        ]
      },
      "else": {
        "not": {
          "required": [
            "skipped"
          ]
        }
      }
    },
    {
      "title": "collect deferred",
      "properties": {
        "job": {
          "const": "collect"
        },
        "status": {
          "const": "deferred"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "title": "judge ok",
      "properties": {
        "job": {
          "const": "judge"
        },
        "status": {
          "const": "ok"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "이번 실행이 낸 반려 판정 ID. 승인 대기로 간 접수는 판정이 없어 나오지 않는다."
        }
      },
      "required": [
        "decisions"
      ],
      "additionalProperties": false
    },
    {
      "title": "prune ok",
      "properties": {
        "job": {
          "const": "prune"
        },
        "status": {
          "const": "ok"
        },
        "applied": {
          "type": "boolean"
        },
        "bundle_release_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "submission_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freed_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "description": "dry-run이면 null"
        },
        "attempts_purged": {
          "type": [
            "integer",
            "null"
          ],
          "description": "dry-run이면 null"
        },
        "skipped_protected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "applied일 때만"
        }
      },
      "required": [
        "applied",
        "bundle_release_ids",
        "submission_ids",
        "freed_bytes",
        "attempts_purged"
      ],
      "additionalProperties": false
    },
    {
      "title": "failed (BoundaryError, 설정 오류, 예기치 못한 예외)",
      "properties": {
        "status": {
          "const": "failed"
        },
        "code": {
          "enum": [
            "NOT_FOUND",
            "INVALID_RECORD",
            "UNSUPPORTED_VERSION",
            "CONFLICT",
            "INTEGRITY_ERROR",
            "FAILED_PRECONDITION",
            "PERMISSION_DENIED",
            "UNAVAILABLE"
          ]
        },
        "reason": {
          "type": "string"
        },
        "job": {
          "enum": [
            "collect",
            "judge",
            "prune"
          ]
        }
      },
      "required": [
        "code",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
